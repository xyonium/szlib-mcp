# 深圳图书馆数字资源 MCP —— 环境变量
# 复制成 .env 后填写；.env 已在 .gitignore 中，不会入库。

# ── 凭据（仅在你希望自动重登时填写）─────────────────────────
# 读者证号（或身份证号；新办证首次需用证号登录后设置强密码）
SZLIB_USERNAME=
# 网上登录强密码
SZLIB_PASSWORD=

# ── 浏览器 profile ─────────────────────────────────────────
# 持久化 profile 目录，保存 cookie 与 localStorage；含明文会话，勿入库
SZLIB_PROFILE_DIR=./data/profile
# 是否无头运行。true=不弹窗；遇到需要人工验证码时自动临时弹出
SZLIB_HEADLESS=true

# ── 保活策略 ───────────────────────────────────────────────
# 空闲超过这个分钟数就停止保活（模拟"人不在用"）；有请求时再按需恢复
SZLIB_IDLE_STOP_MINUTES=240
# 保活间隔的随机范围（分钟），避免固定节奏
SZLIB_KEEPALIVE_MIN_MINUTES=30
SZLIB_KEEPALIVE_MAX_MINUTES=50

# ── 请求节流 ───────────────────────────────────────────────
# 两次上游请求之间的最小间隔（秒），串行执行
SZLIB_MIN_REQUEST_INTERVAL=3

# ── 对外服务（验证页 / MCP）────────────────────────────────
# 验证页的对外地址，Traefik 反代后的域名；留空则返回相对路径
SZLIB_PUBLIC_BASE_URL=https://mcp.example.com/szlib
# 容器内监听端口（MCP 端点与验证页共用）
SZLIB_VERIFY_PORT=8765
# 单个验证链接的有效期（秒）
SZLIB_VERIFY_TTL=300

# ── 门户入口 ───────────────────────────────────────────────
SZLIB_PORTAL=https://er.szlib.org.cn:8899
# 数据库 id：知网=4，万方=65，读秀=2，维普=189
SZLIB_DB_CNKI=4
SZLIB_DB_WANFANG=65
SZLIB_DB_DUXIU=2
SZLIB_DB_VIP=189
